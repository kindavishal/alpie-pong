# Realtime transport. Server-side only; browsers get short-lived tokens from /api/ably-token.
# Ably's free plan is enough. The key needs the publish, subscribe and presence capabilities.
ABLY_API_KEY=

# The race. Every model here starts free, with no credit card (lib/decide/endpoints.ts).
# Alpie (169Pi): an OpenAI-style base URL ending in /v1 (not /chat/completions). Seed and Core may share one, or each set its own.
ALPIE_BASE_URL=
ALPIE_SEED_BASE_URL=
ALPIE_CORE_BASE_URL=
# Key, if the endpoint wants one (sent as a bearer token). ALPIE_CORE_API_KEY falls back to ALPIE_API_KEY.
ALPIE_API_KEY=
ALPIE_CORE_API_KEY=
# Model ids, when they differ from the lane defaults (alpie_9b and alpie-32b).
ALPIE_SEED_MODEL=
ALPIE_CORE_MODEL=
# Ministral 3 8B: a Mistral key (console.mistral.ai, free Experiment plan, needs a phone number).
MISTRAL_API_KEY=
# Sarvam 105B: a subscription key (dashboard.sarvam.ai, free sign-up credits); the base URL defaults to https://api.sarvam.ai/v2.
SARVAM_API_KEY=
SARVAM_BASE_URL=
# Qwen 3.8 27B and Gemma 4 26B-A4B: a Cloudflare account ID and a Workers AI API token (dash.cloudflare.com, free plan).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Comparison only, not the race: Gemini 3.5 Flash-Lite on Google's Gemini API (aistudio.google.com/apikey),
# with billing on for the key's project; the base URL defaults to its OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_BASE_URL=

# Comparison only, not the race: Sarvam-M and Fathom-R1-14B on Featherless through the Hugging Face
# router, which bills per call. A fine-grained token with "Make calls to Inference Providers".
# HF_BILL_TO names an organisation to bill instead of the token's owner (sent as X-HF-Bill-To).
HF_TOKEN=
HF_BILL_TO=

# Guards anything that spends model credit with nobody playing (/arena, demo games, /api/record,
# /api/compare) in production. Open on a local `pnpm dev`.
ADMIN_TOKEN=

# Optional, for the comparison tool only.
# The original Jev Pong lanes on the Vercel AI Gateway, which needs a card on file.
# On Vercel deployments OIDC is used automatically; locally `vercel env pull` also provides VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
